cd ~/DL

cat > .gitignore <<'EOF'
# Python environments
venv/
.venv/
env/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Datasets and trained checkpoints
data/
models/
*.pth
*.pt
*.ckpt
*.safetensors

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Temporary files and archives
*.tmp
*.bak
*.zip
*.tar.gz
*.tgz
.DS_Store

# Editors
.vscode/
.idea/

# LaTeX intermediate files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
EOF